NODE_ENV=development
PORT=3000

# Atlas only; use the credentials for this project's database user.
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@quanlymuonsach.csiixui.mongodb.net/
MONGODB_DB_NAME=quanlymuonsach

JWT_SECRET=<strong-random-secret>
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=<backend-google-callback-url>
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Cloudinary image uploads. Never add these values to VITE_* variables.
CLOUDINARY_CLOUD_NAME=ovs0odtq
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<new-rotated-cloudinary-api-secret>
CLOUDINARY_UPLOAD_PRESET=manage_book_at_library
